<mjml>

    <mj-head>

        <mj-raw>
            <meta name="color-scheme" content="light dark">
            <meta name="supported-color-schemes" content="light dark">
        </mj-raw>

    </mj-head>

    <mj-body>
        <mj-wrapper background-color="#380e88" padding="20px">
            <mj-section padding="0px">

                <mj-column width="100%">
                    <mj-text color="#fefefe" font-size="13px" font-family="serif" padding="10px 0px">
                        www.spsglobalsearch.com &nbsp;&nbsp;|&nbsp;&nbsp; nigel@spsglobalsearch.com &nbsp;&nbsp;|&nbsp;&nbsp; <img src="https://upload.wikimedia.org/wikipedia/commons/c/ca/LinkedIn_logo_initials.png" width="14" style="vertical-align: middle; margin-right: 4px;" alt="LinkedIn"/> Nigel Bartlett
                    </mj-text>
                </mj-column>

            </mj-section>

            <mj-section padding="20px 0px 0px 0px">

                <mj-column width="40%">
                <!-- Headshot -->
                    <mj-image 
                        src="https://www.spsglobalsearch.com/assets/images/email-images/nigel_email.png"
                        alt="Nigel Bartlett"
                        width="130px"
                        border-radius="50%"
                        padding="0px"
                    />

                    <!-- text -->
                    <mj-text
                        align="center"
                        color="#fefefe"
                        font-size="15px"
                        font-family="serif"
                        font-style="italic"
                        padding="15px 0px 0px 0px"
                    >
                        Our man in Bermuda
                    </mj-text>
                </mj-column>

                <mj-column width="60%">
                    <mj-text align="right" color="#fefefe" font-size="28px" font-weight="bold" font-family="serif" padding="0px">
                        Nigel Bartlett
                    </mj-text>

                    <mj-text align="right" color="#fefefe" font-size="20px" font-family="serif" padding="5px 0px 20px 0px">
                    Senior Consultant
                    </mj-text>

                    <mj-text align="right" color="#fefefe" font-size="12px" font-family="serif" padding="0px 0px 5px 0px" line-height="18px">
                        Connecting the best hidden talent<br>
                        with leading employers worldwide since 2003
                    </mj-text>

                    <mj-divider border-width="2px" border-color="#C9A02E" width="100%" padding="5px 0px"/>
                </mj-column>

            </mj-section>

        </mj-wrapper>
    </mj-body>
</mjml>